# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only these emails can sign in (comma-separated)
ALLOWED_EMAILS=you@example.com,friend@example.com

# Used for sign-in links when the request has no Origin header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Job-finding agent ---
# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the scoring model (defaults to claude-haiku-5-5)
# ANTHROPIC_MODEL=
# From rapidapi.com → JSearch (free tier). Without it, only Remotive and RemoteOK are searched.
JSEARCH_API_KEY=
# Optional: the X-RapidAPI-Host from your RapidAPI code snippet, if it isn't jsearch.p.rapidapi.com
# JSEARCH_HOST=
# From Supabase → Project Settings → API Keys → secret / service_role. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/find-jobs
CRON_SECRET=

# --- Applying by email ---
# Each user adds their Gmail and app password in Settings. They're encrypted with this key.
# Generate it with: openssl rand -base64 32. Server-only, and don't change it later or saved passwords stop working.
CREDENTIALS_KEY=
# Optional: the owner's Gmail from the environment instead of Settings. Only the user whose
# sign-in email matches GMAIL_USER can send through it.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# GMAIL_FROM_NAME=Your Name
# Optional: override the tailoring model (defaults to claude-opus-5-5)
# TAILOR_MODEL=
